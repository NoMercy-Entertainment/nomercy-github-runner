version: 2
ethernets:
  # rnr-internal: the controller, the agents and the host's SSH, static.
  mgmt:
    match:
      macaddress: "{{MGMT_MAC}}"
    set-name: mgmt0
    addresses: [{{ADDRESS}}/{{PREFIX_LENGTH}}]
  # The Default Switch: outbound only, by the host's own NAT. Its DNS is not
  # used - the resolvers below are, as the WSL distro's are.
  uplink:
    match:
      macaddress: "{{UPLINK_MAC}}"
    set-name: uplink0
    dhcp4: true
    dhcp4-overrides:
      use-dns: false
    nameservers:
      addresses: [{{DNS}}]
