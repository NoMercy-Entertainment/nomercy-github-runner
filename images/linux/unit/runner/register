#!/usr/bin/env bash
# Register this unit's runner with its forge. Run by the agent with
# `docker exec -i <unit> /runner/register`, the plan on standard input:
#
#   {"url": ..., "token": ..., "name": ..., "labels": ..., "runner_group": ...}
#
# Prints one line of JSON, {"registration_id": ..., "registration_uuid": ...},
# which the agent passes back to the controller. Nothing else goes to standard
# output; progress and errors go to standard error.
#
# **The token is never on a command line** where the worker's `ps` would show
# it, for GitHub. The GitHub runner reads any of its arguments from an
# ACTIONS_RUNNER_INPUT_<NAME> variable, and the token goes that way.
# forgejo-runner has no such input; its token is on `register`'s command line
# for the second the command runs - as scripts/start-forgejo.sh has always
# done - and a Forgejo registration token is the controller's to rotate.
#
# Idempotent: a unit that is registered already answers with the registration
# it has, and registers nothing - unless the plan says `replace`, which is the
# controller saying it holds no registration for this runner. The files on the
# registration volume outlive the record at the forge: `deregister` leaves
# them deliberately, and a record the controller deleted while undoing a
# failed provision is gone while the unit still answers with its id. Every
# registration after that named a record that did not exist, and the wait for
# it to come online could only end at the deadline (2026-09-20).
set -euo pipefail
. /runner/lib.sh
refuse_outside_a_container

plan="$(cat)"
field() { printf '%s' "$plan" | jq -r --arg k "$1" '.[$k] // ""'; }

answer() {
  case "$RUNNER_KIND" in
    github)  jq -c '{registration_id: (.agentId | tostring),
                     registration_uuid: null}' "$RUNNER_REG_DIR/.runner" ;;
    forgejo) jq -c '{registration_id: (.id | tostring),
                     registration_uuid: .uuid}' "$RUNNER_REG_DIR/.runner" ;;
  esac
}

if registered && [ "$(field replace)" != "true" ]; then
  answer
  exit 0
fi

url="$(field url)"; name="$(field name)"; labels="$(field labels)"
group="$(field runner_group)"
[ -n "$url" ] || { echo "the plan names no forge" >&2; exit 65; }
mkdir -p "$RUNNER_REG_DIR"

case "$RUNNER_KIND" in
  github)
    # config.sh is run in the runner's own directory, with no links in place:
    # it reads the files it is about to write, and a link pointing at a file
    # that does not exist yet is a FileNotFoundException rather than a fresh
    # registration (measured against GitHub, 2026-09-20). The files move into
    # the registration volume afterwards, and are linked back - which is what
    # makes a unit on the same volume the same runner.
    for f in $REG_FILES; do
      rm -f "$RUNNER_HOME/$f"
    done
    cd "$RUNNER_HOME"
    export RUNNER_ALLOW_RUNASROOT=1
    export ACTIONS_RUNNER_INPUT_TOKEN ACTIONS_RUNNER_INPUT_URL \
           ACTIONS_RUNNER_INPUT_WORK
    ACTIONS_RUNNER_INPUT_TOKEN="$(field token)"
    ACTIONS_RUNNER_INPUT_URL="$url"
    ACTIONS_RUNNER_INPUT_WORK="$RUNNER_WORK_DIR"
    # Only what the plan names: an empty group or label list set as an empty
    # input is not the same as none.
    [ -n "$name" ]   && export ACTIONS_RUNNER_INPUT_NAME="$name"
    [ -n "$labels" ] && export ACTIONS_RUNNER_INPUT_LABELS="$labels"
    [ -n "$group" ]  && export ACTIONS_RUNNER_INPUT_RUNNERGROUP="$group"
    ./config.sh --unattended --replace --disableupdate >&2
    mkdir -p "$RUNNER_REG_DIR"
    for f in $REG_FILES; do
      [ -e "$RUNNER_HOME/$f" ] || continue
      # A link rather than a file: another registration of this unit moved
      # it and linked it back while this one was running - the controller
      # retries an exec that has not answered. Moving the link into the
      # volume makes it point at itself, and the runner aborts on "too many
      # levels of symbolic links" every time it starts (2026-09-20).
      if [ -L "$RUNNER_HOME/$f" ]; then continue; fi
      mv -f "$RUNNER_HOME/$f" "$RUNNER_REG_DIR/$f"
      ln -sfn "$RUNNER_REG_DIR/$f" "$RUNNER_HOME/$f"
    done
    ;;
  forgejo)
    # Bounded: forgejo-runner pings an unreachable instance for ever, and the
    # agent gives up on this after 120 s, leaving it running in the unit.
    #
    # And tried again: the instance answers that ping in about five seconds
    # through the gate in front of it, which is where forgejo-runner gives
    # up - "Cannot ping the Forgejo instance server ... context deadline
    # exceeded" - and a registration that failed for that reason succeeded
    # on the next attempt (2026-09-20). A registration token may be used
    # again, so an attempt that never reached the instance costs nothing.
    cd "$RUNNER_REG_DIR"
    attempt=1
    until timeout 90 "$FORGEJO_RUNNER_BIN" register --no-interactive \
        --instance "$url" --token "$(field token)" --name "$name" \
        --labels "$labels" >&2; do
      if [ "$attempt" -ge 3 ]; then
        echo "the forge did not register this runner in $attempt attempts" >&2
        exit 71
      fi
      attempt=$((attempt + 1))
      echo "registration attempt $attempt" >&2
      sleep 5
    done
    ;;
esac

if ! registered; then
  echo "the forge's runner reported success but left no registration" >&2
  exit 70
fi
answer
