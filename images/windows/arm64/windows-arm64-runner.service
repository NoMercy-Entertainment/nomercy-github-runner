[Unit]
Description=Windows 11 ARM64 QEMU runner guest
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/runner-appliances

[Service]
Type=simple
User=root
Group=root
ExecStart=/var/lib/runner-appliances/windows-arm64/start-qemu.sh
ExecStop=/var/lib/runner-appliances/windows-arm64/stop-qemu.sh $MAINPID
Restart=on-failure
RestartSec=15
TimeoutStopSec=600
KillMode=control-group

[Install]
WantedBy=multi-user.target
