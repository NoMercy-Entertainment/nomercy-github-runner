GH_TOKEN=
GITHUB_ORG=NoMercy-Entertainment
RUNNER_LABELS=self-hosted,Linux,X64
RUNNER_GROUP=
RUNNER_REPLICAS=3
RUNNER_CPU_LIMIT=0
RUNNER_MEM_LIMIT=0

# --- Single sign-on -------------------------------------------------------
# The URL browsers actually use. The OAuth redirect_uri is built from this and
# never from request headers: the dashboard is also reachable on its LAN
# address, where Host and X-Forwarded-Host are forgeable, and a forged one
# would send the authorization code to another host.
DASH_PUBLIC_URL=https://gh-runners.example.tld

OIDC_ISSUER=https://auth.example.tld/realms/YourRealm
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The callback registered with the IdP must be <DASH_PUBLIC_URL>/callback.
# That path is not arbitrary here: the reused client's redirect URI is
# https://*.phillippepelzer.me/callback, and the wildcard covers the host
# segment, not the path.

# Bootstrap for the first owner, who cannot be approved by anyone else.
# Matched once, then bound to that account's immutable sub and never read
# again - so renaming the account cannot transfer ownership. Deliberately not
# "first to sign in becomes owner": this dashboard is reachable beyond the
# host, and that is a race whose prize is the fleet.
DASH_OWNER=oidc:preferred_username:your-username
