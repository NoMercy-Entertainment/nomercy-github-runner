GH_TOKEN=
GITHUB_ORG=NoMercy-Entertainment
RUNNER_LABELS=self-hosted,Linux,X64
RUNNER_GROUP=
RUNNER_REPLICAS=3
RUNNER_CPU_LIMIT=0
RUNNER_MEM_LIMIT=0

# --- Single sign-on -------------------------------------------------------
# The URL browsers actually use. The OAuth redirect_uri is built from this and
# never from request headers: the dashboard is also reachable on its LAN
# address, where Host and X-Forwarded-Host are forgeable, and a forged one
# would send the authorization code to another host.
DASH_PUBLIC_URL=https://gh-runners.example.tld

OIDC_ISSUER=https://auth.example.tld/realms/YourRealm
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The callback registered with the IdP must be <DASH_PUBLIC_URL>/callback.
# That path is not arbitrary here: the reused client's redirect URI is
# https://*.phillippepelzer.me/callback, and the wildcard covers the host
# segment, not the path.

# There is no seeded owner. The allowlist starts empty, and the first account
# to sign in while no admin exists becomes admin; everyone after that lands in
# a pending queue for an admin to approve. The realm behind OIDC_ISSUER is
# therefore the perimeter: only its accounts can reach that first sign-in.

# --- Forgejo runners -------------------------------------------------------
# The public URL, not http://forgejo:3000 - that compose network does not
# exist on the runners' distro - and not the host gateway 172.28.192.1, which
# changes across a reboot.
FORGEJO_INSTANCE_URL=https://forgejo.example.tld

# A personal API token scoped to the owner's own Forgejo account (user:
# Read and Write, plus repository: Read). Used to read runner status, close
# out run history, deregister a removed runner, and mint a registration
# token per new runner - all through Forgejo's user-scoped endpoints
# (/api/v1/user/actions/runners and its siblings), never the admin ones. A
# runner registered through the admin endpoints is visible to every
# repository and every user on the instance, which is not what this token
# is for - do not mint it with admin rights.
FORGEJO_API_TOKEN=

# Label-to-image mapping for job containers, exactly as forgejo-runner
# register --labels expects it. Required: registering with an empty --labels
# produces a runner that appears healthy in Forgejo and silently never picks
# up a job, so the dashboard refuses to create a Forgejo runner without it.
FORGEJO_RUNNER_LABELS=ubuntu-latest:docker://data.forgejo.org/oci/node:lts,ubuntu-22.04:docker://node:20-bookworm-slim,ubuntu-24.04:docker://node:22-noble

# A runner REGISTRATION token, from Forgejo's
# Site Administration -> Actions -> Runners page. Needed only by the
# forgejo-runner-1 service in docker-compose.runners.yml, and only on its very
# first boot: scripts/start-forgejo.sh reads it when /data/.runner does not
# exist yet and is fatal without it, so an operator who skips this key gets a
# container that restart-loops rather than an error anywhere visible.
#
# Runners the DASHBOARD creates never read this. It mints a fresh registration
# token per runner through the admin API above, which is why there is no
# shared registration token anywhere else in this file.
FORGEJO_RUNNER_REGISTRATION_TOKEN=
